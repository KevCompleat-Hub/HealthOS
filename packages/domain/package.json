{
  "name": "@healthos/domain",
  "version": "0.1.0-m1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2020 --outfile=dist/index.js"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.9",
    "@types/node": "22.10.2",
    "esbuild": "0.21.5"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  }
}